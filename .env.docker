# Configuración para `docker compose` (S3 local con SeaweedFS + Mailpit): no requiere credenciales de AWS.
# Uso: cp .env.docker .env
APP_NAME="Compartir Archivos"
APP_ENV=development
APP_URL=http://localhost:8081
APP_KEY=ZGV2LWtleS1zb2xvLXBhcmEtZGVzYXJyb2xsby1sb2NhbA==
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

DB_HOST=mysql
DB_PORT=3306
DB_NAME=fileshare
DB_USER=fileshare
DB_PASS=fileshare

AWS_ACCESS_KEY_ID=localadmin
AWS_SECRET_ACCESS_KEY=localadmin-secret
AWS_REGION=us-east-1
S3_BUCKET=fileshare
S3_PREFIX=
# El servidor habla con el S3 local por la red de Docker; el navegador por localhost.
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_USE_PATH_STYLE=true
S3_PRESIGN_UPLOAD_TTL=1800
S3_PRESIGN_DOWNLOAD_TTL=600

UPLOAD_SINGLE_MAX_BYTES=15728640
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_MAX_FILE_BYTES=5368709120
FOLDER_MAX_BYTES=53687091200
ZIP_MAX_BYTES=5368709120
ZIP_MAX_FILES=2000
BLOCKED_EXTENSIONS=exe,bat,cmd,sh,msi,scr,js,vbs,ps1

MAIL_DSN=smtp://mailpit:1025
MAIL_FROM="Compartir Archivos <no-reply@localhost>"

SESSION_LIFETIME_MIN=480
MAGIC_SESSION_LIFETIME_MIN=120
LOG_LEVEL=debug

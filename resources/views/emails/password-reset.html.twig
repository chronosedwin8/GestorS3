{% extends 'emails/layout.html.twig' %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:20px;color:#0f172a;">Restablece tu contraseña</h1>
<p style="margin:0 0 12px;">Hola {{ name }},</p>
<p style="margin:0;">Recibimos una solicitud para cambiar tu contraseña. Pulsa el botón para crear una nueva. El enlace vence en {{ minutes }} minutos.</p>
{% include 'emails/_button.html.twig' with { url: url, label: 'Crear nueva contraseña' } %}
<p style="margin:16px 0 0;font-size:13px;color:#64748b;">Si no fuiste tú, ignora este correo: tu contraseña seguirá igual.</p>
{% endblock %}

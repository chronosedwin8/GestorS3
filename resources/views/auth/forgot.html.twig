{% extends 'layouts/auth.html.twig' %}
{% set pageTitle = 'Recuperar contraseña' %}

{% block content %}
<h1 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">¿Olvidaste tu contraseña?</h1>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Escribe tu correo y te enviaremos un enlace para crear una nueva.</p>

<form method="post" action="{{ url('/forgot-password') }}" class="mt-6 space-y-4" x-data="{ busy: false }" @submit="busy = true">
    <input type="hidden" name="_csrf" value="{{ app.csrf }}" hidden>
    <div>
        <label for="email" class="label">Correo electrónico</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="email" class="input" placeholder="nombre@entidad.com">
    </div>
    <button type="submit" class="btn-primary btn-lg w-full" :disabled="busy">
        <span x-text="busy ? 'Enviando…' : 'Enviar enlace'">Enviar enlace</span>
    </button>
</form>
{% endblock %}

{% block below %}
<p class="mt-6 text-center text-sm"><a href="{{ url('/login') }}" class="font-medium text-brand-600 hover:underline dark:text-brand-400">← Volver a iniciar sesión</a></p>
{% endblock %}

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
APP_NAME="Compartir Archivos"
# production | development | testing
APP_ENV=production
# URL pública completa. Si la app vive en un subdirectorio (p. ej. XAMPP),
# incluye la ruta: http://localhost:8080/GestorS3
APP_URL=https://archivos.ejemplo.com
# 32 bytes en base64 para firmar tokens. Generar con:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
# Dominios de correo de la institución (separados por comas). Quien sea invitado desde una carpeta con
# uno de estos dominios obtiene una cuenta "usuario"; los demás quedan como "externos" (el admin puede cambiarlo).
INTERNAL_DOMAINS=

# ---------------------------------------------------------------------------
# Base de datos (MySQL 8, utf8mb4)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fileshare
DB_USER=
DB_PASS=

# ---------------------------------------------------------------------------
# Amazon S3 (o compatible: MinIO, SeaweedFS... en desarrollo)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=            # se entregará después
AWS_SECRET_ACCESS_KEY=        # se entregará después
AWS_REGION=us-east-1
S3_BUCKET=                    # se entregará después
S3_PREFIX=                    # opcional, subdirectorio dentro del bucket (sin "/" final)
S3_ENDPOINT=                  # vacío para AWS; p. ej. http://s3:8333 para el S3 local de Docker
S3_PUBLIC_ENDPOINT=           # opcional: endpoint visto por el navegador si difiere de S3_ENDPOINT (Docker)
S3_USE_PATH_STYLE=false       # true para almacenamientos compatibles (Docker)
S3_PRESIGN_UPLOAD_TTL=1800    # segundos de validez de URLs de subida
S3_PRESIGN_DOWNLOAD_TTL=600   # segundos de validez de URLs de descarga/vista

# ---------------------------------------------------------------------------
# Límites (el administrador puede sobrescribirlos desde el panel)
# ---------------------------------------------------------------------------
UPLOAD_SINGLE_MAX_BYTES=15728640      # <= 15 MB: PUT simple; mayor: multipart
UPLOAD_PART_SIZE_BYTES=8388608        # tamaño mínimo de parte (8 MB)
UPLOAD_MAX_FILE_BYTES=5368709120      # 5 GB por archivo
FOLDER_MAX_BYTES=53687091200          # 50 GB por carpeta raíz
ZIP_MAX_BYTES=5368709120              # 5 GB por descarga ZIP
ZIP_MAX_FILES=2000                    # archivos por descarga ZIP
# Lista negra de extensiones (control blando). Vacío = todas permitidas.
BLOCKED_EXTENSIONS=exe,bat,cmd,sh,msi,scr,js,vbs,ps1

# ---------------------------------------------------------------------------
# Correo (Symfony Mailer). Usa null://null para no enviar (se registra en storage/logs/mail.log)
# ---------------------------------------------------------------------------
MAIL_DSN=smtp://user:pass@smtp.ejemplo.com:587
MAIL_FROM="Compartir Archivos <no-reply@ejemplo.com>"

# ---------------------------------------------------------------------------
# Sesión y registros
# ---------------------------------------------------------------------------
SESSION_LIFETIME_MIN=480              # inactividad máxima de la sesión
MAGIC_SESSION_LIFETIME_MIN=120        # sesiones abiertas con enlace de acceso
LOG_LEVEL=info

{% extends 'admin/layout.html.twig' %}
{% set pageTitle = 'Almacenamiento' %}

{% block admin %}
<div class="grid gap-4 sm:grid-cols-3">
    <div class="card p-5"><p class="text-sm text-slate-500">Espacio usado</p><p class="mt-1 text-2xl font-semibold text-slate-900 dark:text-white">{{ totalBytes|bytes }}</p></div>
    <div class="card p-5"><p class="text-sm text-slate-500">Archivos</p><p class="mt-1 text-2xl font-semibold text-slate-900 dark:text-white">{{ totalFiles|number_format(0, ',', '.') }}</p></div>
    <div class="card p-5"><p class="text-sm text-slate-500">Carpetas raíz</p><p class="mt-1 text-2xl font-semibold text-slate-900 dark:text-white">{{ rows|length }}</p></div>
</div>

<div class="card mt-6 overflow-x-auto">
    <table class="admin-table">
        <thead><tr><th>Carpeta</th><th>Propietario</th><th>Miembros</th><th>Archivos</th><th class="w-64">Uso (límite {{ folderMax|bytes }})</th></tr></thead>
        <tbody>
        {% for r in rows %}
            {% set pct = folderMax > 0 ? (r.size_bytes / folderMax * 100) : 0 %}
            <tr>
                <td><a href="{{ url('/folders/' ~ r.uuid) }}" class="font-medium text-brand-700 hover:underline dark:text-brand-300">{{ r.name }}</a><p class="text-xs text-slate-500">Creada {{ r.created_at|local_date('d/m/Y') }}</p></td>
                <td class="text-xs"><p class="font-medium">{{ r.owner_name }}</p><p class="text-slate-500">{{ r.owner_entity ?: r.owner_email }}</p></td>
                <td>{{ r.members_count }}</td>
                <td>{{ r.files_count|number_format(0, ',', '.') }}</td>
                <td>
                    <div class="flex items-center gap-3">
                        <div class="progress flex-1"><div class="progress-bar {{ pct > 90 ? 'bg-red-500' : (pct > 70 ? 'bg-amber-500' : '') }}" style="width: {{ min(100, max(pct, r.size_bytes > 0 ? 1 : 0))|round(1) }}%"></div></div>
                        <span class="w-20 text-right text-xs text-slate-600 dark:text-slate-300">{{ r.size_bytes|bytes }}</span>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="py-8 text-center text-slate-500">Aún no hay carpetas.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}

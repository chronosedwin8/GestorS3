{% extends 'admin/layout.html.twig' %}
{% set pageTitle = 'Usuarios' %}

{% block admin %}
<div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <form method="get" action="{{ url('/admin/users') }}" class="flex flex-col gap-2 sm:flex-row">
            <input type="search" name="q" value="{{ q }}" placeholder="Buscar por nombre o correo…" class="input sm:max-w-xs">
            <select name="entity" class="input sm:max-w-xs">
                <option value="">Todas las entidades</option>
                {% for e in entities %}<option value="{{ e.uuid }}" {{ entity == e.uuid ? 'selected' : '' }}>{{ e.name }}</option>{% endfor %}
            </select>
            <button type="submit" class="btn-secondary">{{ icon('search', 'h-4 w-4') }} Filtrar</button>
        </form>

        <p class="mt-4 text-sm text-slate-500">{{ total }} usuario{{ total == 1 ? '' : 's' }}</p>
        <div class="card mt-2 overflow-x-auto">
            <table class="admin-table">
                <thead><tr><th>Usuario</th><th>Entidad</th><th>Rol</th><th>Estado</th><th>Último acceso</th><th></th></tr></thead>
                <tbody>
                {% for u in users %}
                    <tr x-data="{ edit: false }">
                        <td>
                            <p class="font-medium text-slate-900 dark:text-white">{{ u.name }}</p>
                            <p class="text-xs text-slate-500">{{ u.email }}</p>
                        </td>
                        <td class="text-slate-600 dark:text-slate-300">{{ u.entity_name ?: '—' }}</td>
                        <td>{% if u.role == 'admin' %}<span class="badge-brand">Admin</span>{% else %}<span class="badge-gray">Usuario</span>{% endif %}</td>
                        <td>{% if u.status == 'active' %}<span class="badge-green">Activo</span>{% else %}<span class="badge-red">Deshabilitado</span>{% endif %}</td>
                        <td class="whitespace-nowrap text-xs text-slate-500">{{ u.last_login_at|local_date }}</td>
                        <td class="text-right">
                            <button type="button" class="btn-ghost btn-sm" @click="edit = true">{{ icon('pencil', 'h-3.5 w-3.5') }} Editar</button>
                            <template x-teleport="body">
                                <div x-show="edit" x-cloak @keydown.escape.window="edit = false">
                                    <div class="modal-backdrop" @click="edit = false"></div>
                                    <div class="modal-wrap pointer-events-none">
                                        <form method="post" action="{{ url('/admin/users/' ~ u.uuid) }}" class="modal-panel pointer-events-auto max-w-md space-y-4 p-6 text-left">
                                            <input type="hidden" name="_csrf" value="{{ app.csrf }}">
                                            <h2 class="text-lg font-semibold">Editar usuario</h2>
                                            <p class="text-sm text-slate-500">{{ u.email }}</p>
                                            <div><label class="label">Nombre</label><input name="name" value="{{ u.name }}" required class="input"></div>
                                            <div><label class="label">Entidad</label>
                                                <select name="entity" class="input">
                                                    <option value="">Sin entidad</option>
                                                    {% for e in entities %}<option value="{{ e.uuid }}" {{ u.entity_uuid == e.uuid ? 'selected' : '' }}>{{ e.name }}</option>{% endfor %}
                                                </select>
                                            </div>
                                            <div class="grid grid-cols-2 gap-3">
                                                <div><label class="label">Rol</label>
                                                    <select name="role" class="input"><option value="user" {{ u.role == 'user' ? 'selected' : '' }}>Usuario</option><option value="admin" {{ u.role == 'admin' ? 'selected' : '' }}>Administrador</option></select>
                                                </div>
                                                <div><label class="label">Estado</label>
                                                    <select name="status" class="input"><option value="active" {{ u.status == 'active' ? 'selected' : '' }}>Activo</option><option value="disabled" {{ u.status == 'disabled' ? 'selected' : '' }}>Deshabilitado</option></select>
                                                </div>
                                            </div>
                                            <div class="flex justify-end gap-2"><button type="button" class="btn-ghost" @click="edit = false">Cancelar</button><button class="btn-primary">Guardar</button></div>
                                        </form>
                                    </div>
                                </div>
                            </template>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="py-8 text-center text-slate-500">No hay usuarios que coincidan.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'admin/_pagination.html.twig' with { base: url('/admin/users') ~ '?q=' ~ q|url_encode ~ '&entity=' ~ entity|url_encode ~ '&' } %}
    </div>

    <aside class="space-y-6">
        <section class="card p-5">
            <h2 class="flex items-center gap-2 font-semibold text-slate-900 dark:text-white">{{ icon('user-plus', 'h-4 w-4') }} Invitar usuarios</h2>
            <p class="mt-1 text-sm text-slate-500">Recibirán un correo para crear su cuenta. Para darles acceso a una carpeta, invítalos desde la propia carpeta.</p>
            <form method="post" action="{{ url('/admin/users/invite') }}" class="mt-4 space-y-3">
                <input type="hidden" name="_csrf" value="{{ app.csrf }}">
                <textarea name="emails" rows="3" required class="input" placeholder="correo@entidad.com, otro@empresa.co"></textarea>
                <select name="entity" class="input">
                    <option value="">Entidad (automática por dominio)</option>
                    {% for e in entities %}<option value="{{ e.uuid }}">{{ e.name }}</option>{% endfor %}
                </select>
                <button type="submit" class="btn-primary w-full">Enviar invitaciones</button>
            </form>
            {% if inviteResults %}
                <ul class="mt-4 space-y-2 text-sm">
                    {% for r in inviteResults %}
                        <li class="rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800">
                            <p><strong>{{ r.email }}</strong> — {{ r.message }}</p>
                            {% if r.link %}<input readonly value="{{ r.link }}" class="input mt-1 py-1 text-xs" x-data @focus="$event.target.select()">{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="card p-5">
            <h2 class="font-semibold text-slate-900 dark:text-white">Invitaciones pendientes ({{ invitations|length }})</h2>
            <ul class="mt-3 divide-y divide-slate-100 text-sm dark:divide-slate-800">
                {% for i in invitations %}
                    <li class="py-2">
                        <p class="truncate font-medium">{{ i.email }}</p>
                        <p class="truncate text-xs text-slate-500">{{ i.folder_name ? 'Carpeta: ' ~ i.folder_name : 'Sin carpeta' }} · por {{ i.inviter_name }} · vence {{ i.expires_at|local_date('d/m/Y') }}</p>
                    </li>
                {% else %}
                    <li class="py-2 text-slate-500">No hay invitaciones pendientes.</li>
                {% endfor %}
            </ul>
        </section>
    </aside>
</div>
{% endblock %}

{# Notificaciones efímeras (Alpine store "toasts") #}
<div x-data class="pointer-events-none fixed inset-x-0 top-3 z-[60] flex flex-col items-center gap-2 px-3 sm:left-auto sm:right-4 sm:top-4 sm:items-end"
     aria-live="polite" aria-atomic="false">
    <template x-for="t in $store.toasts.items" :key="t.id">
        <div class="pointer-events-auto flex w-full max-w-sm animate-slide-up items-start gap-3 rounded-xl border bg-white px-4 py-3 text-sm shadow-panel dark:bg-slate-800"
             :class="{
                'border-red-200 dark:border-red-500/40': t.type === 'error',
                'border-emerald-200 dark:border-emerald-500/40': t.type === 'success',
                'border-slate-200 dark:border-slate-700': t.type === 'info'
             }" role="status">
            <svg class="mt-0.5 h-5 w-5 shrink-0" :class="{ 'text-red-500': t.type === 'error', 'text-emerald-500': t.type === 'success', 'text-brand-500': t.type === 'info' }">
                <use :href="$store.toasts.icons + '#' + (t.type === 'error' ? 'alert-circle' : (t.type === 'success' ? 'check-circle' : 'info'))"></use>
            </svg>
            <div class="min-w-0 flex-1">
                <p class="text-slate-800 dark:text-slate-100" x-text="t.message"></p>
                <template x-if="t.action">
                    <button type="button" class="mt-1 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400" @click="t.action.run(); $store.toasts.dismiss(t.id)" x-text="t.action.label"></button>
                </template>
            </div>
            <button type="button" class="-mr-1 rounded p-0.5 text-slate-400 hover:text-slate-600" @click="$store.toasts.dismiss(t.id)" aria-label="Cerrar notificación">
                <svg class="h-4 w-4"><use :href="$store.toasts.icons + '#x'"></use></svg>
            </button>
        </div>
    </template>
</div>

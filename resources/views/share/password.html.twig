{% extends 'layouts/auth.html.twig' %}
{% set pageTitle = 'Enlace protegido' %}

{% block content %}
<div class="text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300">{{ icon('lock', 'h-7 w-7') }}</span>
    <h1 class="mt-4 text-xl font-semibold tracking-tight text-slate-900 dark:text-white">“{{ folderName }}”</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Este enlace está protegido. Escribe la contraseña que te compartieron.</p>
</div>
<form method="post" action="{{ url('/s/' ~ token ~ '/unlock') }}" class="mt-6 space-y-4">
    <input type="hidden" name="_csrf" value="{{ app.csrf }}" hidden>
    <div>
        <label for="password" class="label">Contraseña</label>
        <input id="password" name="password" type="password" required autofocus class="input" autocomplete="off">
    </div>
    <button type="submit" class="btn-primary btn-lg w-full">Ver archivos</button>
</form>
{% endblock %}

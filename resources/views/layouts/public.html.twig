{% extends 'layouts/base.html.twig' %}

{% block body %}
<div class="flex min-h-full flex-col">
    <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-900/85">
        <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
            <span class="flex items-center gap-2.5 text-slate-900 dark:text-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white shadow-sm">{{ icon('folder-up', 'h-5 w-5') }}</span>
                <span class="text-base font-semibold tracking-tight">{{ app.name }}</span>
            </span>
            <span class="badge-gray ml-2 hidden sm:inline-flex">{{ icon('link', 'h-3.5 w-3.5') }} Enlace compartido · solo lectura</span>
            <div class="ml-auto">
                {% if app.user %}
                    <a href="{{ url('/') }}" class="btn-ghost">Ir a mis carpetas</a>
                {% else %}
                    <a href="{{ url('/login') }}" class="btn-ghost">Iniciar sesión</a>
                {% endif %}
            </div>
        </div>
    </header>
    <main id="main" class="flex-1">
        {% block content %}{% endblock %}
    </main>
</div>
{% endblock %}

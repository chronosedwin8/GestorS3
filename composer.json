{
    "name": "gestors3/fileshare",
    "description": "Plataforma de intercambio de archivos sobre Amazon S3 (Slim 4 + MySQL)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zlib": "*",
        "aws/aws-sdk-php": "^3.300",
        "maennchen/zipstream-php": "^3.1",
        "monolog/monolog": "^3.5",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "slim/twig-view": "^3.3",
        "symfony/console": "^7.0",
        "symfony/mailer": "^7.0",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "migrate": "phinx migrate -c phinx.php"
    }
}

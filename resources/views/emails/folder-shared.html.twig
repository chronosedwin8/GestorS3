{% extends 'emails/layout.html.twig' %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:20px;color:#0f172a;">Te compartieron una carpeta</h1>
<p style="margin:0 0 12px;">Hola {{ name }},</p>
<p style="margin:0;"><strong>{{ inviterName }}</strong> compartió contigo la carpeta <strong>“{{ folderName }}”</strong> con permiso de <strong>{{ permissionLabel|lower }}</strong>.</p>
{% include 'emails/_button.html.twig' with { url: url, label: 'Abrir carpeta' } %}
{% endblock %}

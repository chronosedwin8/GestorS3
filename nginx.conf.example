# Nginx + PHP-FPM en producción para "Compartir Archivos".
# Copiar a /etc/nginx/sites-available/archivos.conf, ajustar server_name, certificados y socket de PHP-FPM.
# Los archivos se suben y descargan directo desde S3, por lo que Nginx/PHP no necesitan cuerpos grandes.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    listen [::]:80;
    server_name archivos.ejemplo.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name archivos.ejemplo.com;

    root /var/www/app/public;
    index index.php;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/archivos.ejemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/archivos.ejemplo.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    # Las subidas van directo a S3: basta un límite pequeño para formularios y JSON.
    client_max_body_size 10m;

    # --- Cabeceras de seguridad (la app añade CSP, nosniff, Referrer-Policy y X-Frame-Options) ---
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    server_tokens off;

    # --- Compresión ---
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- Bloquear archivos sensibles y directorios fuera de public/ ---
    location ~ /\.(?!well-known) { deny all; }
    location ~* ^/(vendor|storage|config|src|db|tests|resources|node_modules|bin)(/|$) { deny all; }
    location ~* \.(env|lock|neon|dist|md|sql|log)$ { deny all; }

    # --- Assets estáticos con caché larga (llevan ?v=hash) ---
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        access_log off;
        try_files $uri =404;
    }

    # --- Descarga ZIP en streaming: sin buffering y con tiempo amplio ---
    location ~ ^/(api/folders/[0-9a-fA-F-]+|s/[^/]+)/download-zip$ {
        fastcgi_buffering off;
        fastcgi_request_buffering off;
        gzip off;
        fastcgi_read_timeout 3600s;
        fastcgi_send_timeout 3600s;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    # --- Front controller ---
    location / {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 120s;
    }

    # Ningún otro .php es ejecutable.
    location ~ \.php$ { return 404; }
}
